# Copie para .env e preencha: cp .env.example .env
# Obrigatório: segredo do JWT (nunca commite o .env)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-hex-de-64-caracteres

# Opcional: data lógica (padrão = data real). Ex.: HOJE=2026-10-25
HOJE=

# Opcional: SEED=true popula o dataset demo na criação (padrão: banco vazio)
SEED=

# Opcional: API direta do front (padrão "" = via proxy do Nginx)
VITE_API_URL=

# Porta do painel no host
WEB_PORT=8080
